{
  "name": "vector-bookmarks",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply vector-bookmarks --local",
    "db:migrate:remote": "wrangler d1 migrations apply vector-bookmarks --remote",
    "test": "node --test test/*.test.ts",
    "smoke": "bash scripts/smoke.sh"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "^4.141.0"
  }
}
