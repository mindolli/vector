{
  "name": "vector-bookmarks",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply vector-bookmarks --local",
    "db:migrate:remote": "wrangler d1 migrations apply vector-bookmarks --remote"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "^4.141.0"
  }
}
