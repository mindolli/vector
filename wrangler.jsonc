{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 최상위 설정은 개발용이다. 운영 배포는 5페이즈에서 추가할 env.production 으로만 한다
  // (npm run deploy = wrangler deploy --env production). 옵션을 빠뜨려도 운영 자원은 건드리지 않는다.
  "name": "vector-bookmarks",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",

  // public/ 의 정적 파일(검색 UI, 저장 팝업)을 먼저 찾고, 없으면 Worker 코드로 넘어간다.
  "assets": {
    "directory": "./public"
  },

  // D1: 원본 저장소. 개발 중에는 로컬 SQLite(.wrangler/state)를 쓴다.
  // 운영 D1 의 실제 database_id 는 5페이즈에서 env.production 에 넣는다.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vector-bookmarks",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Vectorize: 검색 전용 인덱스 (1024차원, cosine). 로컬에서 흉내 낼 수 없어서 개발 중에도 원격에 연결한다.
  // 로컬 D1 의 ID 와 운영 인덱스의 ID 가 섞이지 않도록 개발 전용 인덱스를 쓴다.
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "bookmarks-dev",
      "remote": true
    }
  ],

  // Workers AI: 저장할 때만 bge-m3 임베딩 호출. 항상 원격이며 개발 중에도 무료 사용량을 쓴다.
  "ai": {
    "binding": "AI",
    "remote": true
  },

  // 매시간 밀린 임베딩·인덱싱 작업 처리
  "triggers": {
    "crons": ["0 * * * *"]
  },

  "observability": {
    "enabled": true
  }
}
